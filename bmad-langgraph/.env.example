# Copy to .env and fill in. Loaded automatically by bmad_langgraph.config via python-dotenv.

# Anthropic key for the default model (anthropic:claude-sonnet-5).
ANTHROPIC_API_KEY=

# Optional: override the model. Any string accepted by
# langchain.chat_models.init_chat_model, e.g.:
#   anthropic:claude-opus-4-8
#   anthropic:claude-haiku-4-5
#   openai:gpt-4.1            (requires `uv add langchain-openai`)
#
# Or, to use a Claude Code / claude.ai subscription instead of a
# pay-per-token API key, use the claude-code: prefix -- this shells out to
# the `claude` CLI's headless mode (`claude -p`) instead of calling the
# Anthropic API directly. No ANTHROPIC_API_KEY needed in this mode; the
# `claude` CLI must be installed and logged in (run `claude` once, interactively).
#   claude-code:sonnet        (alias, or a full id like claude-sonnet-5)
#   claude-code:opus
#   claude-code                (no alias -- uses the CLI's configured default model)
# See src/bmad_langgraph/claude_code_llm.py for how this backend works.
BMAD_MODEL=anthropic:claude-sonnet-5

# Where generated artifacts (PRD, architecture, specs, sprint-status.yaml...) are written.
BMAD_OUTPUT_DIR=./_bmad-output
